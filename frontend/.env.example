# ─── Firebase Configuration ─────────────────────────────────────
# To enable real Google Sign-In (the Google account chooser popup):
#
# 1. Go to https://console.firebase.google.com
# 2. Click "Create a project" → name it "PulseAI" → Continue
# 3. Disable Google Analytics (optional) → Create Project
# 4. In the project dashboard, click the web icon </> to add a web app
# 5. Name it "PulseAI Web" → Register app
# 6. Copy the firebaseConfig values below
# 7. Go to Authentication → Sign-in method → Enable "Google"
# 8. Add your email as the support email → Save
# 9. Restart the dev server: npm run dev
#
# That's it! The Google Sign-In popup will now work.

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
