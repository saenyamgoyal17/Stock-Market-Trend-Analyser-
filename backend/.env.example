# Database
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/pulseai
DIRECT_URL=postgresql://postgres:password@127.0.0.1:5432/pulseai

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Stock Data
POLYGON_IO_API_KEY=your-polygon-api-key
FINNHUB_API_KEY=your-finnhub-api-key

# News & Events
NEWSAPI_KEY=your-newsapi-key
FMP_API_KEY=your-fmp-api-key
BENZINGA_API_KEY=your-benzinga-api-key

# AI
ANTHROPIC_API_KEY=your-anthropic-api-key

# FX
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key

# Google OAuth (configured in Supabase dashboard)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# App
PORT=3000
NODE_ENV=development
JWT_SECRET=your-jwt-secret-minimum-32-chars
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
