datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  FREE
  PRO
  ENTERPRISE
}

enum EventCategory {
  POLITICAL
  MILITARY
  ECONOMIC
  GEOPOLITICAL
  ENVIRONMENTAL
  EARNINGS
  REGULATORY
}

enum EventSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AlertType {
  PRICE_CHANGE_UP
  PRICE_CHANGE_DOWN
  EVENT_DETECTED
  SECTOR_MOVE
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  name           String?
  avatarUrl      String?
  provider       String?
  role           Role            @default(FREE)
  country        String?
  currency       String?
  watchlists     Watchlist[]
  alerts         Alert[]
  searches       SearchHistory[]
  portfolios     Portfolio[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Stock {
  id            String         @id @default(uuid())
  symbol        String         @unique
  name          String
  exchange      String
  country       String
  currency      String
  sector        String?
  industry      String?
  marketCap     BigInt?
  lastPrice     Float?
  lastChange    Float?
  lastChangePct Float?
  lastUpdated   DateTime?
  isActive      Boolean        @default(true)
  priceHistory  PriceHistory[]
  stockEvents   StockEvent[]
}

model PriceHistory {
  id        String   @id @default(uuid())
  stockId   String
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    BigInt
  vwap      Float?
  stock     Stock    @relation(fields: [stockId], references: [id])

  @@index([stockId, timestamp])
}

model WorldEvent {
  id          String        @id @default(uuid())
  title       String
  body        String        @db.Text
  sourceUrl   String
  sourceName  String
  category    EventCategory
  country     String?
  severity    EventSeverity
  sentiment   Float?
  publishedAt DateTime
  detectedAt  DateTime      @default(now())
  isProcessed Boolean       @default(false)
  aiSummary   String?       @db.Text
  stockEvents StockEvent[]
}

model StockEvent {
  id              String     @id @default(uuid())
  stockId         String
  eventId         String
  priceAtEvent    Float
  priceBefore     Float?
  priceAfter1h    Float?
  priceAfter24h   Float?
  changeAfter1h   Float?
  changeAfter24h  Float?
  aiConfidence    Float?
  aiImpactReason  String?    @db.Text
  stock           Stock      @relation(fields: [stockId], references: [id])
  event           WorldEvent @relation(fields: [eventId], references: [id])

  @@index([stockId, eventId])
}

model SectorImpact {
  id           String   @id @default(uuid())
  eventId      String
  sector       String
  changeAvg    Float
  stockCount   Int
  calculatedAt DateTime @default(now())
}

model Watchlist {
  id      String   @id @default(uuid())
  userId  String
  name    String
  symbols String[]
  user    User     @relation(fields: [userId], references: [id])
}

model Alert {
  id            String    @id @default(uuid())
  userId        String
  symbol        String?
  alertType     AlertType
  threshold     Float?
  eventCategory String?
  isActive      Boolean   @default(true)
  lastTriggered DateTime?
  user          User      @relation(fields: [userId], references: [id])
}

model Portfolio {
  id       String @id @default(uuid())
  userId   String
  name     String
  holdings Json
  user     User   @relation(fields: [userId], references: [id])
}

model SearchHistory {
  id     String @id @default(uuid())
  userId String
  query  String
  symbol String?
  user   User   @relation(fields: [userId], references: [id])
}

model FXRate {
  id             String   @id @default(uuid())
  baseCurrency   String
  targetCurrency String
  rate           Float
  updatedAt      DateTime @updatedAt

  @@unique([baseCurrency, targetCurrency])
}
