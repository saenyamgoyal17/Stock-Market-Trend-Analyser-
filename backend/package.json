    "@anthropic-ai/sdk": "^0.24.0",
    "ioredis": "^5.4.1",
    "bullmq": "^5.8.0",
    "ws": "^8.17.0",
    "zod": "^3.23.8",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.0",
